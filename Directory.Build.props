<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
    <Authors>Rodrigo da Cruz Godinho; Alan Benitez; Matheus Souza; Maurício Sant'anna</Authors>
    <Product>DesperdícioZero - Cantina ALAMO SENAC</Product>
  </PropertyGroup>
</Project>
