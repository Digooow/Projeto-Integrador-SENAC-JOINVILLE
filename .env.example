# ==============================================================================
# DesperdícioZero (Cantina ALAMO SENAC) — Exemplo de Variáveis de Ambiente
# ==============================================================================

# 1. Banco de Dados
# Local sem servidor: Sqlite (padrão automático)
# Nuvem gratuita (Render, Neon.tech, Supabase): basta definir DATABASE_URL
Database__Provider=Sqlite
# DATABASE_URL=postgres://usuario:senha@ep-exemplo.us-east-1.aws.neon.tech:5432/cantina_alamo

# 2. Segurança do Painel Desktop (Backoffice)
# Em produção na nuvem, defina uma chave forte e informe-a na aba "Fechamento & Nuvem" do app WPF.
Security__AdminApiKey=troque-por-uma-chave-secreta-forte

# 3. Motor Antidesperdício (Queima das 20:45)
CantinaOperacao__NomeCantina=Cantina ALAMO — SENAC
CantinaOperacao__HorarioQueimaDiaria=20:45
CantinaOperacao__PercentualDescontoPadrao=40
CantinaOperacao__MetaReceitaRecuperadaDiaria=150.00
CantinaOperacao__UrlPublicaCardapio=https://cantina-alamo-senac.onrender.com

# 4. Integração WhatsApp (escolha: Disabled | EvolutionApi | MetaCloudApi)
# - Disabled: custo R$ 0, registra no Outbox e gera links 1-clique wa.me para alunos e grupos.
# - EvolutionApi: open-source gratuito via QR Code; envia automático para alunos E grupos (@g.us).
# - MetaCloudApi: API Oficial da Meta (cota gratuita para conversas de serviço/utilidade).
WhatsApp__Provider=Disabled

# Caso WhatsApp__Provider=EvolutionApi
WhatsApp__EvolutionBaseUrl=http://localhost:8081
WhatsApp__EvolutionInstance=cantina-senac
WhatsApp__EvolutionApiKey=senac_whatsapp_key

# Caso WhatsApp__Provider=MetaCloudApi
WhatsApp__MetaPhoneNumberId=
WhatsApp__MetaAccessToken=
WhatsApp__MetaGraphApiVersion=v21.0
