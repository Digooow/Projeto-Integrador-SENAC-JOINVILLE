<Window x:Class="Projeto_Integrador_SENAC.CadastroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Projeto_Integrador_SENAC.Converters"
        Title="Cadastro de Produtos"
        Height="500"
        Width="700">


    <Window.Resources>
        <conv:MoneyConverter x:Key="MoneyConverter"/>
    </Window.Resources>


    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0"
          ItemsSource="{Binding Produtos}"
          SelectedItem="{Binding ProdutoSelecionado, Mode=TwoWay}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          Margin="0,0,10,0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Preço"
                                    Binding="{Binding Preco, StringFormat=R$ {0:F2}}"
                                    Width="*"/>
                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Column="1">

            <TextBlock Text="Nome"/>
            <TextBox Text="{Binding ProdutoEdicao.Nome, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5"/>

            <TextBlock Text="Preço"/>
            <TextBox Text="{Binding ProdutoEdicao.Preco,
                            Converter={StaticResource MoneyConverter},
                            UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,5"/>

            <TextBlock Text="Quantidade"/>
            <TextBox Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5"/>

            <Button Content="Novo"
                    Command="{Binding NovoCommand}"
                    Margin="0,10,0,0"/>

            <Button Content="Salvar"
                    Command="{Binding SalvarCommand}"
                    Background="#4CAF50"
                    Foreground="White"
                    Margin="0,5"/>

            <Button Content="Excluir"
                    Command="{Binding ExcluirCommand}"
                    Background="#E53935"
                    Foreground="White"
                    Margin="0,5"/>
        </StackPanel>
    </Grid>
</Window>
