<Window x:Class="Projeto_Integrador_SENAC.EstoqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Estoque"
        Height="450"
        Width="700">

    <Grid Margin="10">

        <StackPanel>

            <TextBlock Text="Controle de Estoque"
                       FontSize="20"
                       Margin="0,0,0,10"/>

            <DataGrid ItemsSource="{Binding Produtos}"
                      SelectedItem="{Binding ProdutoSelecionado, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      Height="200">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" />
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" />
                </DataGrid.Columns>

            </DataGrid>

            <TextBlock Text="Quantidade" Margin="0,10,0,0"/>

            <TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged, 
                            TargetNullValue=0, FallbackValue=0}"
                     Margin="0,5"/>

            <StackPanel Orientation="Horizontal" Margin="0,10">

                <Button Content="Vender"
                        Command="{Binding VenderCommand}"
                        Width="100"
                        Margin="5"/>

                <Button Content="Adicionar Estoque"
                        Command="{Binding AdicionarCommand}"
                        Width="150"
                        Margin="5"/>

            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
