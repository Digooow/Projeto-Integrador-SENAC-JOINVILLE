<Window x:Class="Projeto_Integrador_SENAC.Views.AlunoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Alunos" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Novo Aluno" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="Nome:"/>
                <TextBox Text="{Binding Nome}" Width="150" Margin="5"/>
                <Label Content="Email:"/>
                <TextBox Text="{Binding Email}" Width="150" Margin="5"/>
                <Label Content="Matrícula:"/>
                <TextBox Text="{Binding Matricula}" Width="100" Margin="5"/>
                <Button Content="Salvar" Command="{Binding SalvarCommand}" Margin="5"/>
            </StackPanel>
        </GroupBox>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Alunos}" SelectedItem="{Binding AlunoSelecionado}"
                  AutoGenerateColumns="False" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                <DataGridTextColumn Header="Matrícula" Binding="{Binding Matricula}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Excluir Selecionado" Command="{Binding ExcluirCommand}" 
                HorizontalAlignment="Right" Margin="5" Width="120" Height="30" VerticalAlignment="Bottom"/>
    </Grid>
</Window>