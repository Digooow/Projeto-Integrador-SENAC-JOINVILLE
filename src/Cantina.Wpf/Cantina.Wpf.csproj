<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Cantina.Wpf</RootNamespace>
    <AssemblyName>CantinaAlamo</AssemblyName>
    <Version>1.2.0</Version>
    <InformationalVersion>1.2.0</InformationalVersion>
    <Product>DesperdícioZero — Cantina ALAMO</Product>
    <Company>SENAC Joinville</Company>
    <UseWPF>true</UseWPF>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cantina.Contracts\Cantina.Contracts.csproj" />
    <ProjectReference Include="..\Cantina.Api\Cantina.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.wpf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

