<Window x:Class="Cantina.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesperdícioZero — Painel Gerencial Cantina ALAMO (SENAC)"
        Width="1360"
        Height="840"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#12356B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- BARRA LATERAL DESPERDÍCIOZERO (Inspirada no Slide 5 da Equipe) -->
        <Border Grid.Column="0" Background="{StaticResource NavySidebarBrush}" Padding="16,20">
            <DockPanel LastChildFill="False">
                <!-- Identidade Visual -->
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,22">
                    <TextBlock Text="DesperdícioZero"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="Cantina ALAMO • SENAC Joinville"
                               Foreground="#93C5FD"
                               FontSize="12"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Menu de Navegação -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Command="{Binding NavegarCommand}" CommandParameter="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSecaoDashboard}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="📊  Visão Geral &amp; Queima" />
                    </Button>

                    <Button Command="{Binding NavegarCommand}" CommandParameter="Pedidos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSecaoPedidos}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛎️  Fila Web &amp; PDV" VerticalAlignment="Center" />
                            <Border Background="#F59E0B" CornerRadius="10" Padding="7,1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding PedidosPendentesFila}"
                                           Foreground="#0F172A"
                                           FontWeight="Bold"
                                           FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavegarCommand}" CommandParameter="Cardapio">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSecaoCardapio}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="🥐  Cardápio &amp; Estoque" />
                    </Button>

                    <Button Command="{Binding NavegarCommand}" CommandParameter="WhatsApp">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSecaoWhatsApp}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="💬  WhatsApp &amp; Alunos" />
                    </Button>

                    <Button Command="{Binding NavegarCommand}" CommandParameter="Fechamento">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSecaoFechamento}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="☁️  Fechamento &amp; Nuvem" />
                    </Button>
                </StackPanel>

                <!-- Rodapé Lateral: Atalho para o Site e Status -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#0C2F5E" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Canal WhatsApp" Foreground="#93C5FD" FontSize="11" />
                            <TextBlock Text="{Binding ModoIntegracaoWhatsApp}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,6" />
                            <TextBlock Text="{Binding HorarioProgramadoQueima, StringFormat='Queima automática às {0}'}"
                                       Foreground="#86EFAC"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Button Content="🌐 Abrir Site de Pedidos"
                            Command="{Binding AbrirSitePedidosCommand}"
                            Style="{StaticResource SuccessButtonStyle}"
                            Margin="0,0,0,6" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra Superior de Status e Sincronização -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="22,12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#10B981" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServidorOnline}" Value="False">
                                            <Setter Property="Fill" Value="#EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding TextoStatusConexao}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding UltimaAtualizacaoTexto, StringFormat='  •  Sincronizado às {0}'}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🔄 Sincronizar Agora"
                                Command="{Binding AtualizarTudoCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="⚡ Disparar Queima 20:45"
                                Command="{Binding DispararQueimaEstoqueCommand}"
                                Style="{StaticResource WarningButtonStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Banner de Feedback / Toast -->
            <Border Grid.Row="1"
                    Visibility="{Binding VisibilidadeFeedback}"
                    Margin="22,12,22,0"
                    CornerRadius="8"
                    Padding="14,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Setter Property="BorderBrush" Value="#86EFAC" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FeedbackErro}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2" />
                                <Setter Property="BorderBrush" Value="#FCA5A5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Command="{Binding FecharFeedbackCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Padding="6,0" />
                    <TextBlock Text="{Binding MensagemFeedback}"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- ================================================================ -->
            <!-- ABA 1: VISÃO GERAL & QUEIMA DE ESTOQUE (DASHBOARD DESPERDÍCIOZERO) -->
            <!-- ================================================================ -->
            <ScrollViewer Grid.Row="2"
                          Visibility="{Binding VisibilidadeDashboard}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,16">
                <StackPanel>
                    <!-- 4 KPI Cards Principais -->
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="PRODUTOS &amp; OFERTAS ATIVAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding TotalProdutosAtivos}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding ProdutosEmOferta, StringFormat='{}{0} em promoção no site  •  '}" FontSize="12" Foreground="{StaticResource AmberPromoBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UnidadesEmEstoque, StringFormat='{}{0} unidades no balcão'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="FILA FURA-FILA (SITE WEB)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding PedidosPendentesFila}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,6,0,2" />
                                <TextBlock Text="Pedidos aguardando preparo/retirada" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding TotalAlunosCadastrados, StringFormat='{}{0} alunos cadastrados'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="RECEITA TOTAL HOJE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceitaTotalHoje, StringFormat=C2}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding ReceitaNormalHoje, StringFormat='Preço cheio: {0:C2}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding EconomiaGeradaAosAlunosHoje, StringFormat='Economia aos alunos: {0:C2}'}" FontSize="12" Foreground="{StaticResource EmeraldGreenBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="RECEITA RECUPERADA (META)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EmeraldGreenBrush}" />
                                <TextBlock Text="{Binding ReceitaRecuperadaHoje, StringFormat=C2}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource EmeraldGreenBrush}" Margin="0,6,0,4" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding PercentualMetaBarra}" Height="8" Foreground="#16A34A" Background="#E2E8F0" />
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding PercentualMetaTexto}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MetaReceitaRecuperadaDiaria, StringFormat='Meta {0:C0}'}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Bloco Central: Campanha Queima 20:45 + Mensagem WhatsApp -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="🔥 Motor Antidesperdício — Queima das 20:45" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Aplica desconto automático nos salgados e doces perecíveis do dia, atualiza a vitrine online imediatamente e dispara o cardápio promocional nos grupos de WhatsApp do SENAC."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,12" />

                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                                        <TextBlock Text="Desconto (%):" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding PercentualQueimaInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="65"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <CheckBox Content="Somente perecíveis do dia"
                                              IsChecked="{Binding ApenasPereciveisQueima}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,16,4" />
                                    <CheckBox Content="Notificar grupos WhatsApp"
                                              IsChecked="{Binding DispararWhatsAppQueima}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,0,4" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="🚀 Aplicar Queima &amp; Notificar Grupos"
                                            Command="{Binding DispararQueimaEstoqueCommand}"
                                            Style="{StaticResource WarningButtonStyle}"
                                            Margin="0,0,10,0" />
                                    <Button Content="📋 Copiar Texto WhatsApp"
                                            Command="{Binding CopiarMensagemQueimaCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>

                                <TextBox Text="{Binding UltimaMensagemQueima, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="135"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#F8FAFC"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="10"
                                         BorderBrush="#CBD5E1" />
                            </StackPanel>
                        </Border>

                        <!-- Ofertas Ativas na Vitrine Web -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="🏷️ Ofertas Ativas Agora no Site" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding OfertasAtivas}" Height="245">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="" Binding="{Binding IconeEmoji}" Width="36" />
                                        <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*" />
                                        <DataGridTextColumn Header="De" Binding="{Binding PrecoVenda, StringFormat=C2}" Width="75" />
                                        <DataGridTextColumn Header="Por" Binding="{Binding PrecoFinal, StringFormat=C2}" Width="75" />
                                        <DataGridTextColumn Header="Off" Binding="{Binding PercentualDescontoEfetivo, StringFormat='{}{0:N0}%'}" Width="55" />
                                        <DataGridTextColumn Header="Disp." Binding="{Binding QuantidadeDisponivel}" Width="55" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Rodapé do Dashboard: Grupos SENAC e Principais Clientes -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="📲 Grupos WhatsApp por Turno (SENAC)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding GruposWhatsApp}" Height="165">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding Nome}" Width="*" />
                                        <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="80" />
                                        <DataGridTextColumn Header="Membros" Binding="{Binding ParticipantesEstimados}" Width="80" />
                                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="55" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="🏆 Principais Clientes (Fura-Fila Web)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding PrincipaisClientes}" Height="165">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Aluno" Binding="{Binding Nome}" Width="*" />
                                        <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="85" />
                                        <DataGridTextColumn Header="Pedidos" Binding="{Binding TotalPedidos}" Width="70" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalGasto, StringFormat=C2}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================================ -->
            <!-- ABA 2: FILA DE PEDIDOS WEB & VENDA RÁPIDA DE BALCÃO (PDV)        -->
            <!-- ================================================================ -->
            <ScrollViewer Grid.Row="2"
                          Visibility="{Binding VisibilidadePedidos}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,16">
                <StackPanel>
                    <!-- Fila Ativa de Pedidos Online -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🛎️ Fila de Pedidos Online em Tempo Real" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Avance o status para avisar o aluno no WhatsApp quando o lanche estiver pronto para retirada no balcão."
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <CheckBox DockPanel.Dock="Right"
                                          Content="Abrir WhatsApp Web (wa.me) automaticamente ao mudar status"
                                          IsChecked="{Binding AbrirWaMeAoNotificar}"
                                          VerticalAlignment="Center" />
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding PedidosFila}"
                                      SelectedItem="{Binding PedidoFilaSelecionado}"
                                      Height="250">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Código" Binding="{Binding CodigoRetirada}" Width="95" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="135" />
                                    <DataGridTextColumn Header="Aluno / Cliente" Binding="{Binding NomeCliente}" Width="*" />
                                    <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="75" />
                                    <DataGridTextColumn Header="Pagto" Binding="{Binding FormaPagamento}" Width="95" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding ValorTotal, StringFormat=C2}" Width="85" />
                                    <DataGridTextColumn Header="Recuperado" Binding="{Binding ReceitaRecuperada, StringFormat=C2}" Width="95" />
                                    <DataGridTemplateColumn Header="Ações Rápidas" Width="340">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Preparar"
                                                            Command="{Binding DataContext.IniciarPreparoPedidoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,4"
                                                            Margin="2,0" />
                                                    <Button Content="✅ Pronto"
                                                            Command="{Binding DataContext.MarcarProntoPedidoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource WarningButtonStyle}"
                                                            Padding="8,4"
                                                            Margin="2,0" />
                                                    <Button Content="Entregar"
                                                            Command="{Binding DataContext.ConcluirRetiradaPedidoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SuccessButtonStyle}"
                                                            Padding="8,4"
                                                            Margin="2,0" />
                                                    <Button Content="💬"
                                                            ToolTip="Abrir conversa WhatsApp com o aluno"
                                                            Command="{Binding DataContext.AbrirWhatsAppPedidoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Padding="8,4"
                                                            Margin="2,0" />
                                                    <Button Content="✕"
                                                            ToolTip="Cancelar pedido e devolver reserva ao estoque"
                                                            Command="{Binding DataContext.CancelarPedidoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Padding="8,4"
                                                            Margin="2,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- PDV Venda Rápida de Balcão + Histórico -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="⚡ Venda Rápida no Balcão (PDV)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <TextBlock Text="Produto disponível:" FontSize="12" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Produtos}"
                                          SelectedItem="{Binding ProdutoBalcaoSelecionado}"
                                          DisplayMemberPath="Nome"
                                          Padding="8,6"
                                          Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Qtd:" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding QuantidadeBalcaoInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Pagamento:" FontSize="12" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding FormasPagamentoDisponiveis}"
                                                  SelectedItem="{Binding FormaPagamentoBalcao}"
                                                  Padding="8,6" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Cliente (opcional):" FontSize="12" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ClienteBalcaoInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,14" />

                                <Button Content="💰 Registrar Venda Presencial"
                                        Command="{Binding RegistrarVendaBalcaoCommand}"
                                        Style="{StaticResource SuccessButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="📜 Histórico Recente de Pedidos (Site &amp; Balcão)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding HistoricoPedidos}" Height="230">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoRetirada}" Width="95" />
                                        <DataGridTextColumn Header="Origem" Binding="{Binding Origem}" Width="75" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                                        <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}" Width="*" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding ValorTotal, StringFormat=C2}" Width="85" />
                                        <DataGridTextColumn Header="Recuperado" Binding="{Binding ReceitaRecuperada, StringFormat=C2}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================================ -->
            <!-- ABA 3: CARDÁPIO, ESTOQUE & PROMOÇÕES                             -->
            <!-- ================================================================ -->
            <ScrollViewer Grid.Row="2"
                          Visibility="{Binding VisibilidadeCardapio}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,16">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🥐 Catálogo de Produtos Sincronizado com o Site" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Produtos}"
                                      SelectedItem="{Binding ProdutoSelecionado}"
                                      Height="250">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" />
                                    <DataGridTextColumn Header="" Binding="{Binding IconeEmoji}" Width="35" />
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*" />
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding CategoriaNome}" Width="125" />
                                    <DataGridTextColumn Header="Custo" Binding="{Binding PrecoCusto, StringFormat=C2}" Width="75" />
                                    <DataGridTextColumn Header="Preço" Binding="{Binding PrecoVenda, StringFormat=C2}" Width="75" />
                                    <DataGridTextColumn Header="Final" Binding="{Binding PrecoFinal, StringFormat=C2}" Width="75" />
                                    <DataGridTextColumn Header="Desc." Binding="{Binding PercentualDescontoEfetivo, StringFormat='{}{0:N0}%'}" Width="60" />
                                    <DataGridTextColumn Header="Físico" Binding="{Binding QuantidadeEstoque}" Width="60" />
                                    <DataGridTextColumn Header="Res." Binding="{Binding QuantidadeReservada}" Width="55" />
                                    <DataGridTextColumn Header="Disp." Binding="{Binding QuantidadeDisponivel}" Width="60" />
                                    <DataGridCheckBoxColumn Header="Perec." Binding="{Binding Perecivel}" Width="55" />
                                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="55" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Formulário CRUD Produto -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding TituloFormularioProduto}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right"
                                            Content="+ Novo Produto"
                                            Command="{Binding LimparFormularioProdutoCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,4" />
                                </DockPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Emoji:" FontSize="12" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding FormProdutoEmoji, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Nome do Produto:" FontSize="12" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding FormProdutoNome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Categoria:" FontSize="12" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding Categorias}"
                                                  SelectedItem="{Binding CategoriaFormularioSelecionada}"
                                                  DisplayMemberPath="Nome"
                                                  Padding="8,6" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Descrição no cardápio online:" FontSize="12" Margin="0,0,0,3" />
                                <TextBox Text="{Binding FormProdutoDescricao, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,8" />

                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Custo (R$):" FontSize="12" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding FormProdutoPrecoCusto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Venda (R$):" FontSize="12" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding FormProdutoPrecoVenda, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Estoque:" FontSize="12" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding FormProdutoEstoque, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <CheckBox Content="Perecível do dia (entra na Queima 20:45)" IsChecked="{Binding FormProdutoPerecivel}" Margin="0,0,16,0" />
                                    <CheckBox Content="Visível no site" IsChecked="{Binding FormProdutoAtivo}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="💾 Salvar Produto"
                                            Command="{Binding SalvarProdutoCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,10,0" />
                                    <Button Content="🗑️ Excluir Selecionado"
                                            Command="{Binding ExcluirProdutoSelecionadoCommand}"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ajuste de Estoque & Descontos (% e R$) -->
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📦 Reposição / Baixa Rápida de Estoque" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="+1" Command="{Binding AjustarEstoqueRapidoCommand}" CommandParameter="1" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                                        <Button Content="+5" Command="{Binding AjustarEstoqueRapidoCommand}" CommandParameter="5" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                                        <Button Content="+10" Command="{Binding AjustarEstoqueRapidoCommand}" CommandParameter="10" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                                        <Button Content="-1" Command="{Binding AjustarEstoqueRapidoCommand}" CommandParameter="-1" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" />
                                        <TextBox Text="{Binding DeltaEstoqueManualInput, UpdateSourceTrigger=PropertyChanged}" Width="55" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,6,0" />
                                        <Button Content="Aplicar" Command="{Binding AjustarEstoqueManualCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="🏷️ Promoções Individuais e em Lote (% ou R$)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Desconto (%):" FontSize="12" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding DescontoPercentualInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Ou Valor Fixo (R$):" FontSize="12" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding DescontoValorFixoInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <CheckBox Content="Aplicar lote apenas em perecíveis" IsChecked="{Binding DescontoApenasPereciveis}" Margin="0,0,0,10" />

                                    <WrapPanel>
                                        <Button Content="Aplicar no Item" Command="{Binding AplicarDescontoIndividualCommand}" Style="{StaticResource WarningButtonStyle}" Margin="0,0,6,6" />
                                        <Button Content="Zerar Item" Command="{Binding ZerarDescontoIndividualCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" />
                                        <Button Content="Aplicar em Lote" Command="{Binding AplicarDescontoLoteCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,6" />
                                        <Button Content="Zerar Todos" Command="{Binding ZerarTodosDescontosCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================================ -->
            <!-- ABA 4: WHATSAPP (GRUPOS DE TURNO, ALUNOS & AUDITORIA DE DISPAROS)-->
            <!-- ================================================================ -->
            <ScrollViewer Grid.Row="2"
                          Visibility="{Binding VisibilidadeWhatsApp}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Grupos de Turno SENAC -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="📲 Grupos de Ofertas por Turno" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="+ Novo Grupo" Command="{Binding NovoGrupoCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding GruposWhatsApp}"
                                          SelectedItem="{Binding GrupoSelecionado}"
                                          Height="145"
                                          Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding Nome}" Width="*" />
                                        <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="75" />
                                        <DataGridTextColumn Header="JID API" Binding="{Binding DestinoApiJid}" Width="115" />
                                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="50" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FormGrupoNome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,6,0" ToolTip="Nome do grupo" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding TurnosDisponiveis}" SelectedItem="{Binding FormGrupoTurno}" Padding="6" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="2" Text="{Binding FormGrupoParticipantes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" ToolTip="Participantes" />
                                </Grid>

                                <TextBlock Text="Link de convite (exibido no site) e JID opcional (Evolution API @g.us):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="155" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FormGrupoLink, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Text="{Binding FormGrupoJid, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Salvar Grupo" Command="{Binding SalvarGrupoCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="Abrir Link Convite" Command="{Binding AbrirLinkGrupoCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Cadastro de Alunos -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="🎓 Alunos Cadastrados (Alertas VIP WhatsApp)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <DataGrid ItemsSource="{Binding Alunos}" Height="145" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                                        <DataGridTextColumn Header="WhatsApp" Binding="{Binding TelefoneWhatsApp}" Width="115" />
                                        <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="70" />
                                        <DataGridTemplateColumn Header="" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕"
                                                            Command="{Binding DataContext.ExcluirAlunoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Padding="6,2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <TextBox Text="{Binding FormAlunoNome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,6,0" ToolTip="Nome completo" />
                                    <TextBox Text="{Binding FormAlunoEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" ToolTip="E-mail institucional" />
                                </UniformGrid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="105" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FormAlunoTelefone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,6,0" ToolTip="WhatsApp com DDD" />
                                    <TextBox Grid.Column="1" Text="{Binding FormAlunoMatricula, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,6,0" ToolTip="Matrícula" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding TurnosDisponiveis}" SelectedItem="{Binding FormAlunoTurno}" Padding="6" />
                                </Grid>

                                <Button Content="+ Cadastrar Aluno" Command="{Binding CadastrarAlunoCommand}" Style="{StaticResource SuccessButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Outbox / Log de Notificações WhatsApp -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="📨 Central de Disparos WhatsApp (Automático API + Fallback 1-Clique wa.me)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding NotificacoesWhatsApp}" Height="235">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Horário" Binding="{Binding CriadaEm, StringFormat='{}{0:dd/MM HH:mm}'}" Width="100" />
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="145" />
                                    <DataGridTextColumn Header="Canal" Binding="{Binding Canal}" Width="115" />
                                    <DataGridTextColumn Header="Destino" Binding="{Binding Destinatario}" Width="135" />
                                    <DataGridCheckBoxColumn Header="Auto" Binding="{Binding EnviadoAutomaticamente}" Width="50" />
                                    <DataGridTextColumn Header="Status / Retorno Gateway" Binding="{Binding DetalheStatus}" Width="*" />
                                    <DataGridTemplateColumn Header="Enviar Manual" Width="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="💬 Abrir wa.me"
                                                        Command="{Binding DataContext.AbrirLinkNotificacaoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SuccessButtonStyle}"
                                                        Padding="8,3" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================================ -->
            <!-- ABA 5: FECHAMENTO DIÁRIO, AUDITORIA & SERVIDOR NA NUVEM          -->
            <!-- ================================================================ -->
            <ScrollViewer Grid.Row="2"
                          Visibility="{Binding VisibilidadeFechamento}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,16">
                <StackPanel>
                    <!-- Conexão com Servidor Web / Cloud -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="☁️ Conexão com o Serviço Web (Local ou Hospedagem Gratuita Render / Fly.io)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Aponte este aplicativo Desktop para http://localhost:5180 (modo local integrado) ou para a URL pública gratuita onde o site da cantina estiver hospedado."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,3,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="URL Base da API &amp; Site de Pedidos:" FontSize="12" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding ApiBaseUrlConfig, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Chave X-Api-Key do Backoffice (opcional em localhost):" FontSize="12" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding AdminApiKeyConfig, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <Button Content="🔌 Salvar &amp; Reconectar"
                                            Command="{Binding SalvarConfiguracaoServidorCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Iniciar servidor web local automaticamente quando URL for localhost"
                                      IsChecked="{Binding AutoStartLocalConfig}" />
                        </StackPanel>
                    </Border>

                    <!-- Fechamento Diário Antidesperdício -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="📊 Fechamento Diário de Caixa &amp; Receita Recuperada" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBox Text="{Binding ObservacoesFechamentoInput, UpdateSourceTrigger=PropertyChanged}"
                                             Width="260"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Margin="0,0,8,0"
                                             ToolTip="Observações do turno" />
                                    <Button Content="Consolidar Fechamento de Hoje"
                                            Command="{Binding GerarFechamentoDiarioCommand}"
                                            Style="{StaticResource SuccessButtonStyle}" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding Fechamentos}" Height="175">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding DataReferencia}" Width="95" />
                                    <DataGridTextColumn Header="Normal" Binding="{Binding ReceitaNormal, StringFormat=C2}" Width="95" />
                                    <DataGridTextColumn Header="Recuperada" Binding="{Binding ReceitaRecuperada, StringFormat=C2}" Width="105" />
                                    <DataGridTextColumn Header="Receita Total" Binding="{Binding ReceitaTotal, StringFormat=C2}" Width="105" />
                                    <DataGridTextColumn Header="Descontos" Binding="{Binding DescontosConcedidos, StringFormat=C2}" Width="95" />
                                    <DataGridTextColumn Header="Pedidos Site" Binding="{Binding PedidosWebConcluidos}" Width="95" />
                                    <DataGridTextColumn Header="Balcão" Binding="{Binding VendasBalcaoConcluidas}" Width="75" />
                                    <DataGridTextColumn Header="Itens Oferta" Binding="{Binding ItensVendidosPromocao}" Width="90" />
                                    <DataGridTextColumn Header="Sobras" Binding="{Binding ItensSobraramEstoque}" Width="75" />
                                    <DataGridTextColumn Header="Observações" Binding="{Binding Observacoes}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Auditoria de Movimentações de Estoque -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="📋 Trilhas de Auditoria de Estoque" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding MovimentacoesEstoque}" Height="195">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data/Hora" Binding="{Binding OcorridaEm, StringFormat='{}{0:dd/MM HH:mm}'}" Width="105" />
                                    <DataGridTextColumn Header="Produto" Binding="{Binding NomeProduto}" Width="190" />
                                    <DataGridTextColumn Header="Operação" Binding="{Binding Tipo}" Width="135" />
                                    <DataGridTextColumn Header="Delta" Binding="{Binding QuantidadeDelta}" Width="65" />
                                    <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoPosterior}" Width="65" />
                                    <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
